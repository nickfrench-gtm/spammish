{
  "name": "spammish",
  "version": "0.3.1",
  "description": "A deterministic, local-first Gmail agent that moves confirmed cold sales and obvious spam to The Abyss.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "test": "node --test lib/*.test.mjs",
    "check": "node scripts/check-source.mjs",
    "desktop": "electron .",
    "package:preview": "node scripts/package-desktop.mjs --preview",
    "package:desktop": "node scripts/package-desktop.mjs --universal"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.mjs",
  "author": {
    "name": "Spammish contributors"
  }
}
