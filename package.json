{
  "name": "spammish",
  "version": "0.4.3",
  "description": "Make unwanted email disappear with local, deterministic Gmail filtering.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "test": "node --test lib/*.test.mjs",
    "check": "node scripts/check-source.mjs",
    "desktop": "electron .",
    "package:preview": "node scripts/package-desktop.mjs --preview",
    "package:desktop": "node scripts/package-desktop.mjs --universal",
    "configure": "node scripts/configure-local.mjs",
    "setup": "node scripts/configure-local.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.mjs",
  "author": {
    "name": "Spammish contributors"
  }
}
